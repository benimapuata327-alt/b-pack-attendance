# B-PACK ATTENDANCE — Configuration frontend
# Copiez ce fichier en .env et adaptez les valeurs.

# URL de base de votre API Laravel (sans slash final).
# Laissez vide pour utiliser le mode développement local (localStorage).
# Exemple Laragon :  VITE_LARAVEL_API_URL=http://bpack.test/api
# Exemple artisan :   VITE_LARAVEL_API_URL=http://localhost:8000/api
VITE_LARAVEL_API_URL=
